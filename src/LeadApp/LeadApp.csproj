    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>623d3cc3-7c09-43d6-95e0-8173049ec849</UserSecretsId>
