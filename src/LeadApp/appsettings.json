{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Crm": {
    "BaseUrl": "https://crm.example.ba",
    "CreateOpportunityPath": "/api/sales-opportunity/web/create",
    "DefaultSourceCode": "EMAIL",
    "TimeoutSeconds": 15,
    "UseFake": false
  },
  "Firebase": {
    "ProjectId": "mkf-partner-app"
  },
  "Admin": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "LeadForm": {
    "MinAmount": 450,
    "MaxAmount": 10000,
    "Step": 50,
    "DefaultAmount": 5000,
    "Currency": "KM",
    "SubmissionsPerWindow": 5,
    "WindowMinutes": 10
  }
}
