@* Inline stroke icon set (24×24 grid, currentColor). Usage: <Icon Name="home" Size="18" /> *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "home":
            <path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5" />
            break;
        case "tractor":
            <circle cx="7" cy="16" r="4" /><circle cx="7" cy="16" r="1" /><circle cx="18" cy="17.5" r="2.5" />
            <path d="M4 12V6h6l2 6" /><path d="M11 12h6.5a2.5 2.5 0 0 1 2.5 2.5V15" /><path d="M15.5 17.5H11" /><path d="M17 12V8" />
            break;
        case "briefcase":
            <rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 13h18" /><path d="M11 13v1.5h2V13" />
            break;
        case "leaf":
            <path d="M11 20A7 7 0 0 1 4 13c0-6 5-9 16-10-1 11-4 17-9 17Z" /><path d="M4 21c3-6 7-9 12-11" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8" /><path d="M18 14.2a6.5 6.5 0 0 1 3.5 5.8" />
            break;
        case "building":
            <rect x="4" y="3" width="16" height="18" rx="1.5" /><path d="M9 21v-4h6v4" /><path d="M8 7h2M14 7h2M8 11h2M14 11h2" />
            break;
        case "phone":
            <path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 7 7L16 14l5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
            break;
        case "map-pin":
            <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" /><path d="m8 12.5 3 3 5-6" />
            break;
        case "alert":
            <path d="M12 3 2 20h20L12 3Z" /><path d="M12 10v4" /><path d="M12 17h.01" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 8h.01" />
            break;
        case "chart":
            <path d="M3 3v18h18" /><path d="m7 15 4-4 3 3 6-7" />
            break;
        case "grid":
            <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" /><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" /><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" /><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
            break;
        case "inbox":
            <path d="M3 13h5l1.5 3h5L16 13h5" /><path d="M5.5 5h13L21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6l2.5-8Z" />
            break;
        case "megaphone":
            <path d="M3 10v4a1 1 0 0 0 1 1h3l8 5V4L7 9H4a1 1 0 0 0-1 1Z" /><path d="M7 15v4.5a1.5 1.5 0 0 0 3 0V17" /><path d="M19 9a4 4 0 0 1 0 6" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4.5" /><path d="m11.2 11.8 8.8-8.8" /><path d="m17 6 2.5 2.5" /><path d="m14.5 8.5 2 2" />
            break;
        case "lock":
            <rect x="4.5" y="10.5" width="15" height="10.5" rx="2" /><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
            break;
        case "logout":
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="m10 16-4-4 4-4" /><path d="M6 12h10" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "edit":
            <path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z" /><path d="m13.5 6.5 4 4" />
            break;
        case "trash":
            <path d="M4 7h16" /><path d="M10 11v6M14 11v6" /><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" /><path d="M9 7V4h6v3" />
            break;
        case "copy":
            <rect x="8" y="8" width="13" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
            break;
        case "link":
            <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" />
            break;
        case "play":
            <path d="M7 4.5v15l12-7.5-12-7.5Z" />
            break;
        case "pause":
            <path d="M8 5v14M16 5v14" />
            break;
        case "download":
            <path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M4 20h16" />
            break;
        case "refresh":
            <path d="M20 12a8 8 0 0 1-14.3 4.9" /><path d="M4 12A8 8 0 0 1 18.3 7.1" /><path d="M19 3v4.5h-4.5" /><path d="M5 21v-4.5h4.5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "chevron-right":
            <path d="m9 6 6 6-6 6" />
            break;
        case "arrow-right":
            <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            break;
        case "arrow-up":
            <path d="M12 19V5" /><path d="m6 11 6-6 6 6" />
            break;
        case "arrow-down":
            <path d="M12 5v14" /><path d="m6 13 6 6 6-6" />
            break;
        case "shield":
            <path d="M12 3 4.5 6v6c0 4.5 3.2 8 7.5 9 4.3-1 7.5-4.5 7.5-9V6L12 3Z" /><path d="m9 12 2 2 4-4" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "sparkles":
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4" /><path d="m6 6 2 2M16 16l2 2M6 18l2-2M16 8l2-2" />
            break;
        case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />
            break;
        case "target":
            <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" />
            break;
        case "calendar":
            <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />
            break;
        case "coins":
            <ellipse cx="9" cy="7" rx="6" ry="3" /><path d="M3 7v4c0 1.7 2.7 3 6 3s6-1.3 6-3V7" /><path d="M9 14v3c0 1.7 2.7 3 6 3s6-1.3 6-3v-4c0-1.7-2.7-3-6-3" />
            break;
        case "external":
            <path d="M14 4h6v6" /><path d="M20 4 11 13" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
        case "filter":
            <path d="M3 5h18l-7 8.5V19l-4 2v-7.5L3 5Z" />
            break;
        case "send":
            <path d="M21 3 10 14" /><path d="M21 3 14.5 21 10 14 3 9.5 21 3Z" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public double StrokeWidth { get; set; } = 1.9;
    [Parameter] public string? Class { get; set; }
}
