@if (Open)
{
    <div class="modal-backdrop" @onclick="CloseAsync"></div>
    <div class="modal-shell" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onkeydown="OnKeyDown">
        <div class="modal @SizeClass" @onclick:stopPropagation="true">
            <header class="modal-head">
                <div class="modal-title">
                    @if (Icon is not null)
                    {
                        <span class="modal-icon"><Icon Name="@Icon" Size="18" /></span>
                    }
                    <h2 id="@_titleId">@Title</h2>
                </div>
                <button type="button" class="icon-btn" aria-label="Zatvori" @onclick="CloseAsync"><Icon Name="x" Size="18" /></button>
            </header>
            <div class="modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="modal-foot">@Footer</footer>
            }
        </div>
    </div>
}

@code {
    private readonly string _titleId = "m-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private string SizeClass => $"modal-{Size}";

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
