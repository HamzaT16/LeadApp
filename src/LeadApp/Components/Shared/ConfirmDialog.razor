<Modal Open="Open" Title="@Title" Icon="alert" Size="sm" OnClose="OnCancel">
    <ChildContent>
        <p class="confirm-text">@Message</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="OnCancel" disabled="@Busy">Odustani</button>
        <button type="button" class="btn @(Danger ? "btn-danger" : "btn-primary")" @onclick="OnConfirm" disabled="@Busy">
            @if (Busy)
            {
                <span class="spinner"></span>
            }
            @ConfirmText
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "Potvrda";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "Potvrdi";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
