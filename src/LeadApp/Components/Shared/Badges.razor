@* Status badges for CRM sync and campaign state. Pass exactly one of CrmStatus / Campaign. *@
@if (CrmStatus is { } crm)
{
    <span class="badge @(crm switch { CrmSyncStatus.Synced => "badge-success", CrmSyncStatus.Failed => "badge-danger", _ => "badge-warning" })">
        @DisplayNames.Of(crm)
    </span>
}
else if (Campaign is { } c)
{
    var (css, text) = CampaignState(c, Today);
    <span class="badge @css">@text</span>
}

@code {
    [Parameter] public CrmSyncStatus? CrmStatus { get; set; }
    [Parameter] public Campaign? Campaign { get; set; }
    [Parameter] public DateOnly Today { get; set; }

    public static (string Css, string Text) CampaignState(Campaign c, DateOnly today) =>
        c.Status == CampaignStatus.Inactive ? ("badge-neutral", "Neaktivna")
        : today < c.StartDate ? ("badge-info", "Zakazana")
        : today > c.EndDate ? ("badge-warning", "Istekla")
        : ("badge-success", "Aktivna");
}
