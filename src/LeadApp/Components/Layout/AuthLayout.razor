@inherits LayoutComponentBase

<div class="auth">
    <section class="auth-art">
        <div class="auth-art-inner">
            <a class="auth-brand" href="">
                <BrandMark Size="38" />
                <span>PARTNER <b>MKF</b></span>
            </a>
            <LoginIllustration />
            <h2>Leadovi, kampanje i CRM sinhronizacija na jednom mjestu.</h2>
            <p>Pratite upite u realnom vremenu, upravljajte online kampanjama i izvezite podatke jednim klikom.</p>
        </div>
        <svg class="auth-waves" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 120c100-40 200-40 300 0s200 40 300 0v80H0Z" fill="#ffffff" fill-opacity=".06" />
            <path d="M0 150c100-30 200-30 300 0s200 30 300 0v50H0Z" fill="#ffffff" fill-opacity=".08" />
        </svg>
    </section>
    <section class="auth-form">
        @Body
    </section>
</div>
