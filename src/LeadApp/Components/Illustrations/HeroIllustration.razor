@* Isometric-ish scene: a house on a growth chart, floating coins and a card with an approved check. *@
<svg class="hero-illustration" viewBox="0 0 520 380" role="img" aria-label="Ilustracija: kuća, rast i odobren kredit">
    <defs>
        <linearGradient id="hi-sky" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e0f2fe" />
            <stop offset="1" stop-color="#ccfbf1" />
        </linearGradient>
        <linearGradient id="hi-brand" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0066b2" />
            <stop offset="1" stop-color="#14b8a6" />
        </linearGradient>
        <linearGradient id="hi-roof" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0b5fa5" />
            <stop offset="1" stop-color="#004a85" />
        </linearGradient>
        <linearGradient id="hi-area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#14b8a6" stop-opacity=".35" />
            <stop offset="1" stop-color="#14b8a6" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="hi-coin" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fde68a" />
            <stop offset="1" stop-color="#f59e0b" />
        </linearGradient>
        <filter id="hi-shadow" x="-20%" y="-20%" width="140%" height="160%">
            <feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#0f172a" flood-opacity=".14" />
        </filter>
    </defs>

    <!-- backdrop -->
    <rect x="20" y="30" width="480" height="320" rx="36" fill="url(#hi-sky)" />
    <circle cx="420" cy="90" r="34" fill="#fff" opacity=".7" />
    <g stroke="#bae6fd" stroke-width="1.5" opacity=".9">
        <path d="M60 300h400M60 250h400M60 200h400M60 150h400" stroke-dasharray="4 8" />
    </g>

    <!-- growth chart -->
    <path d="M60 300 L130 270 L190 280 L250 220 L320 230 L390 160 L460 120 L460 300 Z" fill="url(#hi-area)" />
    <path class="hi-line" d="M60 300 L130 270 L190 280 L250 220 L320 230 L390 160 L460 120" fill="none" stroke="url(#hi-brand)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="460" cy="120" r="8" fill="#fff" stroke="#14b8a6" stroke-width="4" />

    <!-- house -->
    <g filter="url(#hi-shadow)">
        <rect x="150" y="205" width="150" height="110" rx="8" fill="#fff" />
        <path d="M135 212 225 140l90 72" fill="none" stroke="url(#hi-roof)" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="205" y="250" width="40" height="65" rx="6" fill="url(#hi-brand)" />
        <circle cx="236" cy="284" r="3" fill="#fff" />
        <rect x="165" y="228" width="28" height="26" rx="4" fill="#dbeafe" />
        <rect x="257" y="228" width="28" height="26" rx="4" fill="#dbeafe" />
        <path d="M179 228v26M165 241h28M271 228v26M257 241h28" stroke="#fff" stroke-width="2" />
        <rect x="262" y="150" width="18" height="36" rx="3" fill="#004a85" />
    </g>

    <!-- approval card -->
    <g class="hi-float-a" filter="url(#hi-shadow)">
        <rect x="318" y="238" width="160" height="78" rx="14" fill="#fff" />
        <circle cx="348" cy="277" r="16" fill="#dcfce7" />
        <path d="m340 277 6 6 11-12" fill="none" stroke="#16a34a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="374" y="262" width="82" height="10" rx="5" fill="#0f172a" opacity=".85" />
        <rect x="374" y="281" width="58" height="8" rx="4" fill="#94a3b8" />
    </g>

    <!-- coins -->
    <g class="hi-float-b">
        <ellipse cx="92" cy="150" rx="26" ry="26" fill="url(#hi-coin)" stroke="#fff" stroke-width="4" />
        <ellipse cx="92" cy="150" rx="15" ry="15" fill="none" stroke="#b45309" stroke-width="2.5" opacity=".6" />
        <path d="M92 140v20M86 145.5c0-2.5 2.5-4 6-4s6 1.5 6 4-2.5 3.5-6 4.5-6 2-6 4.5 2.5 4 6 4 6-1.5 6-4" fill="none" stroke="#92400e" stroke-width="2.6" stroke-linecap="round" />
    </g>
    <g class="hi-float-c">
        <ellipse cx="150" cy="96" rx="17" ry="17" fill="url(#hi-coin)" stroke="#fff" stroke-width="3" />
        <path d="M150 88v16M144 96h12" stroke="#92400e" stroke-width="3" stroke-linecap="round" />
    </g>

    <!-- sparkles -->
    <g fill="#0066b2" opacity=".55">
        <path class="hi-twinkle" d="M372 62l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" />
        <path class="hi-twinkle d2" d="M478 196l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" />
        <path class="hi-twinkle d3" d="M52 222l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" />
    </g>
</svg>
